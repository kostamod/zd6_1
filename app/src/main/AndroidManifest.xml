<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <!-- Picasso 2.8 содержит NotificationAction, но здесь используется только into(ImageView); уведомления приложение не отправляет. -->
 <uses-feature android:name="android.hardware.type.watch" android:required="true"/>
 <application android:allowBackup="false" android:label="WorldCinema" android:icon="@drawable/ic_cinema" android:theme="@style/AppTheme" android:supportsRtl="true">
  <meta-data android:name="com.google.android.wearable.standalone" android:value="true"/>
  <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
 </application>
</manifest>
