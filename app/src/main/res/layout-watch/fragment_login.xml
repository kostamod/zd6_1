<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:text="WorldCinema" android:textColor="#2A79B1" android:textStyle="bold" android:textSize="18sp" android:gravity="center" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="E-mail" android:textSize="10sp" android:textColor="#2A79B1" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/email" android:hint="you@example.com" android:textSize="12sp" android:padding="0dp" android:inputType="textEmailAddress" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#888888" android:layout_width="match_parent" android:layout_height="30dp"/>
  <TextView android:text="Пароль" android:textSize="10sp" android:textColor="#2A79B1" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <!-- Локальный пароль предусмотрен учебным макетом. Это не вход в сервис. -->
  <EditText android:id="@+id/password" tools:ignore="WearPasswordInput" android:hint="Ваш пароль" android:textSize="12sp" android:padding="0dp" android:inputType="textPassword" android:saveEnabled="false" android:textColor="#FFFFFF" android:textColorHint="#888888" android:layout_width="match_parent" android:layout_height="30dp"/>
  <Button android:id="@+id/login" android:text="Войти" android:textSize="12sp" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#2A79B1" android:layout_width="match_parent" android:layout_height="44dp"/>
 </LinearLayout>
</ScrollView>
